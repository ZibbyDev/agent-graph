{
  "name": "@zibby/agent-graph-memory",
  "version": "0.2.0",
  "description": "A growable, time-aware memory graph for AI agents. SQLite by default (zero runtime dependencies), Postgres optionally, configurable embeddings. JS API, CLI, MCP server, HTTP server.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "agent-graph": "dist/src/cli.js",
    "agent-graph-mcp": "dist/src/mcp.js",
    "agent-graph-server": "dist/src/server.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test 'dist/test/*.test.js'",
    "example": "npm run build && node dist/examples/fleet/run.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "agent",
    "memory",
    "knowledge-graph",
    "sqlite",
    "mcp",
    "temporal",
    "llm",
    "postgres",
    "pgvector",
    "embeddings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZibbyDev/agent-graph-memory.git"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.11.3",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
